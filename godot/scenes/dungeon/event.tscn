[gd_scene load_steps=2 format=3]

[ext_resource path="res://scripts/dungeon/event.gd" type="Script" id="1"]

[node name="Event" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.055, 0.065, 0.09, 1)
mouse_filter = 2

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 100
theme_override_constants/margin_top = 70
theme_override_constants/margin_right = 100
theme_override_constants/margin_bottom = 70

[node name="Content" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="TitleLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "🎲 랜덤 이벤트"
horizontal_alignment = 1

[node name="DescriptionLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "이번 이벤트에서 하나를 선택하세요."
horizontal_alignment = 1

[node name="Choices" type="VBoxContainer" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="RiskyButton" type="Button" parent="MarginContainer/Content/Choices"]
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "이벤트 1"

[node name="SafeButton" type="Button" parent="MarginContainer/Content/Choices"]
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "이벤트 2"

[node name="StatusLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "두 개 중 하나를 선택하세요."
horizontal_alignment = 1

[node name="SkipButton" type="Button" parent="MarginContainer/Content"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
text = "⏭ 이벤트 스킵"

[connection signal="pressed" from="MarginContainer/Content/Choices/RiskyButton" to="." method="_on_risky_button_pressed"]
[connection signal="pressed" from="MarginContainer/Content/Choices/SafeButton" to="." method="_on_safe_button_pressed"]
[connection signal="pressed" from="MarginContainer/Content/SkipButton" to="." method="_on_skip_button_pressed"]

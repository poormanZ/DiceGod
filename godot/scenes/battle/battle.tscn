[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/battle/battle.gd" id="1_battle"]
[ext_resource type="PackedScene" path="res://scenes/dice/dice_roll_panel.tscn" id="2_dice_roll_panel"]
[ext_resource type="Resource" path="res://resources/dice/basic_dice.tres" id="3_basic_dice"]
[ext_resource type="Resource" path="res://resources/characters/basic_player.tres" id="4_basic_player"]
[ext_resource type="Resource" path="res://resources/enemies/basic_slime.tres" id="5_basic_slime"]
[ext_resource type="Resource" path="res://resources/abilities/matching_numbers.tres" id="6_matching_numbers"]
[ext_resource type="Resource" path="res://resources/equipment/straight_gloves.tres" id="7_straight_gloves"]
[ext_resource type="Resource" path="res://resources/dice/healing_dice.tres" id="8_healing_dice"]

[node name="Battle" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_battle")
dice_data = ExtResource("3_basic_dice")
player_data = ExtResource("4_basic_player")
enemy_data = ExtResource("5_basic_slime")
ability_data = ExtResource("6_matching_numbers")
equipment_data = ExtResource("7_straight_gloves")
healing_dice_data = ExtResource("8_healing_dice")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.047, 0.075, 1)
mouse_filter = 2

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 48.0
offset_right = -48.0
offset_bottom = -48.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="TitleLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.83, 0.42, 1)
theme_override_font_sizes/font_size = 36
text = "DiceGod 전투 프로토타입"
horizontal_alignment = 1

[node name="DescriptionLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "주사위를 굴리고, 원하는 결과를 잠근 뒤 한 번 리롤하세요."
horizontal_alignment = 1

[node name="EnemyNameLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.56, 0.56, 1)
theme_override_font_sizes/font_size = 24
horizontal_alignment = 1

[node name="EnemyHpLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.72, 0.72, 1)
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1

[node name="PlayerNameLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.82, 1, 1)
theme_override_font_sizes/font_size = 24
horizontal_alignment = 1

[node name="PlayerHpLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.88, 1, 1)
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1

[node name="DiceRollPanel" parent="MarginContainer/Content" instance=ExtResource("2_dice_roll_panel")]
layout_mode = 2
size_flags_horizontal = 4

[node name="ActionButtons" type="HBoxContainer" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="RollButton" type="Button" parent="MarginContainer/Content/ActionButtons"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "주사위 굴리기"

[node name="RerollButton" type="Button" parent="MarginContainer/Content/ActionButtons"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 20
disabled = true
text = "리롤 (1회)"

[node name="ConfirmButton" type="Button" parent="MarginContainer/Content/ActionButtons"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 20
disabled = true
text = "결과 확정"

[node name="AttackButton" type="Button" parent="MarginContainer/Content/ActionButtons"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2

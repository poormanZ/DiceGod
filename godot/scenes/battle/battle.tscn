[node name="PlayerHpLabel" type="Label" parent="MarginContainer/Content/PlayerArea"]
custom_minimum_size = Vector2(210, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 17
vertical_alignment = 1

[node name="DiceRollPanel" parent="MarginContainer/Content" instance=ExtResource("2_dice_roll_panel")]
layout_mode = 2
size_flags_horizontal = 4

[node name="ActionButtons" type="HBoxContainer" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="RollButton" type="Button" parent="MarginContainer/Content/ActionButtons"]

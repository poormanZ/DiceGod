[connection signal="pressed" from="MarginContainer/Content/ActionButtons/RollButton" to="." method="_on_roll_button_pressed"]
[connection signal="pressed" from="MarginContainer/Content/ActionButtons/RerollButton" to="." method="_on_reroll_button_pressed"]

[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/battle/battle.gd" id="1_battle"]
[ext_resource type="PackedScene" path="res://scenes/dice/dice_roll_panel.tscn" id="2_dice_roll_panel"]
[ext_resource type="Resource" path="res://resources/dice/basic_dice.tres" id="3_basic_dice"]
[ext_resource type="Resource" path="res://resources/characters/basic_player.tres" id="4_basic_player"]
[ext_resource type="Resource" path="res://resources/enemies/basic_slime.tres" id="5_basic_slime"]

[sub_resource type="StyleBoxFlat" id="battle_box"]
bg_color = Color(0.01, 0.01, 0.012, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.92, 0.92, 0.92, 1)

[sub_resource type="StyleBoxFlat" id="button_normal"]
bg_color = Color(0.035, 0.035, 0.04, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.92, 0.92, 0.92, 1)
content_margin_left = 14.0
content_margin_top = 8.0
content_margin_right = 14.0
content_margin_bottom = 8.0

[node name="Battle" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_battle")
dice_data = ExtResource("3_basic_dice")
player_data = ExtResource("4_basic_player")
enemy_data = ExtResource("5_basic_slime")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.005, 0.005, 0.008, 1)
mouse_filter = 2

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = 12.0
offset_right = -40.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 3
alignment = 1

[node name="TitleLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "DICEGOD"
horizontal_alignment = 1

[node name="DescriptionLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.72, 0.76, 1)
theme_override_font_sizes/font_size = 14
text = "⚔️ 🏹 🔮 🗡️ 🛡️ ❤️ 심볼 주사위를 굴리고 행동을 실행하세요."
horizontal_alignment = 1

[node name="SelectedBuildLabel" type="Label" parent="MarginContainer/Content"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.78, 0.25, 1)
theme_override_font_sizes/font_size = 15
text = "⚔️ 🏹 🔮 🗡️ 🛡️ ❤️ 심볼 주사위"
horizontal_alignment = 1
vertical_alignment = 1

[node name="EnemyArea" type="VBoxContainer" parent="MarginContainer/Content"]
custom_minimum_size = Vector2(0, 92)
layout_mode = 2
theme_override_constants/separation = 2
alignment = 1

[node name="EnemyNameLabel" type="Label" parent="MarginContainer/Content/EnemyArea"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.55, 0.55, 1)
theme_override_font_sizes/font_size = 24
text = "적"
horizontal_alignment = 1

[node name="EnemyHpLabel" type="Label" parent="MarginContainer/Content/EnemyArea"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "HP"
horizontal_alignment = 1

[node name="EnemyHint" type="Label" parent="MarginContainer/Content/EnemyArea"]
layout_mode = 2
theme_override_colors/font_color = Color(0.52, 0.52, 0.56, 1)
theme_override_font_sizes/font_size = 12
text = "적의 다음 공격을 확인하세요."
horizontal_alignment = 1

[node name="BattleBox" type="PanelContainer" parent="MarginContainer/Content"]
custom_minimum_size = Vector2(0, 82)
layout_mode = 2
theme_override_styles/panel = SubResource("battle_box")

[node name="BattleBoxLabel" type="Label" parent="MarginContainer/Content/BattleBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "전투 상태"
